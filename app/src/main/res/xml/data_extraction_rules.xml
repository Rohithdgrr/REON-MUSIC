<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <!-- Account DataStore holds email + YouTube channel IDs: never back up -->
        <exclude domain="sharedpref" path="accounts.preferences_pb" />
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="accounts.preferences_pb" />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
