# REON backend (Phase 0+). App talks backend-only; Room seeds are offline fallback.
# Emulator loopback to host PC: http://10.0.2.2:8080 ; physical device: http://<LAN-IP>:8080
REON_API_BASE_URL=http://10.0.2.2:8080
# Optional static key sent as X-Reon-Key. Leave empty to disable.
# REON_API_KEY=change-me

# GEMINI_API_KEY: Legacy AI Studio placeholder, currently unused by the app.
# Kept commented so it is NOT packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
